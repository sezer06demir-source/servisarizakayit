---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '@data/site';
import { devices } from '@data/site';
const year = new Date().getFullYear();
const cols = devices.slice(0, 6);
---

<footer class="ftr">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo dark />
        <p class="ftr__desc">{site.area}. Beyaz eşya ve iklimlendirme cihazlarınızda arıza kaydı oluşturun, en yakın teknisyen sizi arasın.</p>
        <a href={site.phone.href} class="ftr__phone metric">{site.phone.display}</a>
        <p class="ftr__hours"><Icon name="clock" size={15} /> {site.hours.daysText} {site.hours.display}</p>
      </div>
      <nav aria-label="Cihaz servisleri">
        <h2 class="ftr__h">Servis verdiğimiz cihazlar</h2>
        <ul>
          {cols.map((d) => <li><a href={`/servis/${d.slug}`}>{d.name}</a></li>)}
          <li><a href="/#cihazlar">Tümü</a></li>
        </ul>
      </nav>
      <nav aria-label="Kurumsal">
        <h2 class="ftr__h">Kurumsal</h2>
        <ul>
          <li><a href="/ariza-kayit">Arıza Kaydı</a></li>
          <li><a href="/blog">Bilgi Merkezi</a></li>
          <li><a href="/#surec">Servis Süreci</a></li>
          <li><a href="/iletisim">İletişim</a></li>
          <li><a href="/gizlilik-politikasi">Gizlilik</a></li>
          <li><a href="/kvkk-aydinlatma-metni">KVKK</a></li>
        </ul>
      </nav>
    </div>

    <p class="ftr__disclaimer">{site.disclaimer}</p>

    <div class="ftr__bottom">
      <p>© {year} {site.legalName}. Tüm hakları saklıdır.</p>
      <a href={site.whatsapp.href} target="_blank" rel="noopener" class="ftr__wa"><Icon name="whatsapp" size={16} /> WhatsApp destek hattı</a>
      <div class="ftr__credit">
        <span class="ftr__credit-ic"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg></span>
        <span class="ftr__credit-label">Tasarım · SEO · Güvenlik</span>
        <span class="ftr__credit-name">Sezer Demir</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: 3.25rem 2rem;
    font-size: var(--fs-sm);
  }
  .ftr__top {
    display: grid;
    gap: 2.25rem;
  }
  @media (min-width: 720px) {
    .ftr__top {
      grid-template-columns: 1.8fr 1fr 1fr;
    }
  }
  .ftr__desc {
    margin: 1rem 0;
    color: var(--on-dark-dim);
    max-width: 42ch;
  }
  .ftr__phone {
    display: inline-block;
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .ftr__phone:hover {
    color: var(--brand);
  }
  .ftr__hours {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--on-dark-dim);
    margin: 0;
  }
  .ftr__hours svg {
    color: var(--brand);
  }
  .ftr__h {
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 0.7rem;
  }
  .ftr nav ul {
    display: grid;
    gap: 0.45rem;
  }
  .ftr nav a {
    color: var(--on-dark-dim);
    transition: color var(--dur);
  }
  .ftr nav a:hover {
    color: #fff;
  }
  .ftr__disclaimer {
    margin: 2.5rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--dark-line);
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.03);
    color: var(--on-dark-dim);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dark-line);
    color: var(--on-dark-dim);
  }
  .ftr__bottom p {
    margin: 0;
  }
  .ftr__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--on-dark-dim);
  }
  .ftr__wa:hover {
    color: var(--wa);
  }
  .ftr__wa svg {
    color: var(--wa);
  }
  .ftr__credit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem 0.35rem 0.4rem;
    border-radius: 999px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--brand) 22%, transparent), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.7);
  }
  .ftr__credit-ic {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand);
    color: #04211f;
    flex: none;
    box-shadow: 0 0 12px color-mix(in srgb, var(--brand) 50%, transparent);
  }
  .ftr__credit-label {
    color: var(--on-dark-dim);
  }
  .ftr__credit-name {
    font-weight: 800;
    color: var(--brand);
    letter-spacing: -0.01em;
  }
</style>
