---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, nav } from '@data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="hdr" id="site-header">
  <div class="container hdr__in">
    <a href="/" class="hdr__brand" aria-label={`${site.name} ana sayfa`}><Logo /></a>

    <nav class="hdr__nav" aria-label="Ana menü">
      <ul>
        {
          nav.map((n) => {
            const active = n.href.startsWith('/') && !n.href.includes('#') && (path === n.href || path.startsWith(`${n.href}/`));
            return (
              <li>
                <a href={n.href} aria-current={active ? 'page' : undefined}>{n.label}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="hdr__end">
      <a href={site.phone.href} class="hdr__phone">
        <span class="hdr__phone-ic"><Icon name="phone" size={18} /></span>
        <span class="hdr__phone-txt">
          <small data-status-text>{site.hours.daysText}</small>
          <strong class="metric">{site.phone.display}</strong>
        </span>
      </a>
      <a href="/ariza-kayit" class="btn btn--accent hdr__cta">Arıza Kaydı</a>
      <button type="button" class="hdr__menu js-only" aria-expanded="false" aria-controls="mnav" aria-label="Menüyü aç"><Icon name="menu" size={24} /></button>
    </div>
  </div>

  <div class="hdr__mobile" id="mnav" hidden>
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
    <a href="/ariza-kayit" class="btn btn--accent">Arıza Kaydı Oluştur</a>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }
  .hdr__brand {
    margin-right: auto;
  }
  .hdr__nav {
    display: none;
  }
  .hdr__nav ul {
    display: flex;
    gap: 1.35rem;
  }
  .hdr__nav a {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink-2);
    padding-block: 0.3rem;
    border-bottom: 2px solid transparent;
    transition: color var(--dur), border-color var(--dur);
  }
  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--brand-deep);
    border-color: var(--brand);
  }
  .hdr__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .hdr__phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  .hdr__phone-ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand-deep);
    flex: none;
  }
  .hdr__phone-txt {
    display: grid;
    line-height: 1.1;
  }
  .hdr__phone-txt small {
    font-size: 0.8rem;
    color: var(--steel);
  }
  .hdr__phone-txt strong {
    font-size: 1rem;
  }
  .hdr__cta {
    display: none;
    min-height: 44px;
    padding-inline: 1.15rem;
  }
  .hdr__menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--line);
    border-radius: var(--r);
    background: var(--paper);
    color: var(--ink);
  }
  .hdr__mobile {
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding: 0.5rem var(--gutter) 1.1rem;
  }
  .hdr__mobile ul {
    display: grid;
  }
  .hdr__mobile a:not(.btn) {
    display: block;
    padding: 0.85rem 0;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }
  .hdr__mobile .btn {
    width: 100%;
    margin-top: 0.85rem;
  }
  @media (min-width: 720px) {
    .hdr__phone,
    .hdr__cta {
      display: inline-flex;
    }
  }
  @media (min-width: 980px) {
    .hdr__nav {
      display: block;
    }
    .hdr__menu,
    .hdr__mobile {
      display: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__menu');
  const panel = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Menüyü aç' : 'Menüyü kapat');
    if (panel) panel.hidden = open;
  });
</script>
