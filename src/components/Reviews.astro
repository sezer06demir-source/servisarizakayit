---
/** Müşteri yorumları — masaüstünde iki sıra sonsuz kayan şerit, hover'da durur.
 *  Mobilde ve reduced-motion'da düğmeyle yatay kaydırılan sade liste. */
import Stars from './Stars.astro';
import Icon from './Icon.astro';
import { reviews } from '@data/site';
const avg = (reviews.reduce((s, r) => s + r.stars, 0) / reviews.length).toFixed(1);
const rowA = reviews.slice(0, Math.ceil(reviews.length / 2));
const rowB = reviews.slice(Math.ceil(reviews.length / 2));
---

<section class="rev section" id="yorumlar" aria-labelledby="rev-title">
  <div class="container">
    <div class="rev__head">
      <div>
        <p class="eyebrow"><Icon name="star" size={16} /> Müşteri yorumları</p>
        <h2 id="rev-title">Binlerce arıza, memnun müşteriler</h2>
      </div>
      <div class="rev__score">
        <strong class="metric">{avg}</strong>
        <span><Stars value={Number(avg)} size={18} /><small>{reviews.length} değerlendirme</small></span>
      </div>
    </div>
  </div>

  <div class="rev__rows" data-marquee>
    <div class="marquee">
      <div class="marquee__track">
        {[...rowA, ...rowA].map((r) => (
          <article class="rcard">
            <Stars value={r.stars} />
            <p class="rcard__text">{r.text}</p>
            <p class="rcard__by"><strong>{r.name}</strong> · {r.city} · <span>{r.device}</span></p>
          </article>
        ))}
      </div>
    </div>
    <div class="marquee marquee--rev">
      <div class="marquee__track">
        {[...rowB, ...rowB].map((r) => (
          <article class="rcard">
            <Stars value={r.stars} />
            <p class="rcard__text">{r.text}</p>
            <p class="rcard__by"><strong>{r.name}</strong> · {r.city} · <span>{r.device}</span></p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rev {
    overflow: hidden;
  }
  .rev__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .rev__score {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .rev__score > strong {
    font-size: 2.6rem;
    color: var(--brand-deep);
    line-height: 1;
  }
  .rev__score span {
    display: grid;
    gap: 0.15rem;
  }
  .rev__score small {
    font-size: var(--fs-sm);
    color: var(--steel);
  }
  .rev__rows {
    display: grid;
    gap: 1rem;
  }
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: scroll 46s linear infinite;
  }
  .marquee--rev .marquee__track {
    animation-duration: 54s;
    animation-direction: reverse;
  }
  .rev__rows:hover .marquee__track {
    animation-play-state: paused;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  .rcard {
    flex: 0 0 340px;
    max-width: 82vw;
    padding: 1.25rem 1.35rem;
    border: 1.5px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper);
  }
  .rcard__text {
    margin: 0.6rem 0 0.85rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .rcard__by {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--steel);
  }
  .rcard__by strong {
    color: var(--ink);
  }
  .rcard__by span {
    color: var(--brand-deep);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .rev__rows {
      grid-auto-flow: row;
    }
    .marquee {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee__track {
      animation: none;
    }
  }
</style>
