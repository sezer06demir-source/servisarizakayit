---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import RequestForm from '@components/RequestForm.astro';
import { posts } from '@data/blog';
import { devices } from '@data/site';
import { breadcrumbSchema, articleSchema } from '@utils/seo';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const path = `/blog/${post.slug}`;
const device = devices.find((d) => d.slug === post.device);
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Bilgi Merkezi', href: '/blog' },
  { name: post.title, href: path },
];
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const dateLabel = new Date(post.date + 'T00:00:00').toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={post.seoTitle} rawTitle description={post.seoDescription} keywords={post.keywords} schema={[breadcrumbSchema(crumbs), articleSchema({ title: post.title, description: post.seoDescription, path, date: post.date })]}>
  <article class="section">
    <div class="container ledger">
      <div class="body">
        <ol class="crumbs">{crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}</ol>
        <p class="eyebrow"><Icon name="file-text" size={16} /> Bilgi merkezi</p>
        <h1>{post.title}</h1>
        <p class="meta"><span><Icon name="clock" size={14} /> {post.readMinutes} dk okuma</span><span>·</span><time datetime={post.date}>{dateLabel}</time></p>

        <div class="post prose">
          {
            post.body.map((b) => {
              if (b.type === 'h2') return <h2 class="post__h2">{b.text}</h2>;
              if (b.type === 'ul') return <ul class="post__ul">{b.items.map((i) => <li>{i}</li>)}</ul>;
              if (b.type === 'ol') return <ol class="post__ol">{b.items.map((i) => <li>{i}</li>)}</ol>;
              if (b.type === 'note') return <p class="post__note"><Icon name="shield-check" size={16} /> {b.text}</p>;
              return <p>{b.text}</p>;
            })
          }
        </div>

        {
          device && (
            <a href={`/servis/${device.slug}`} class="crossbox">
              <span class="crossbox__ic"><Icon name={device.icon} size={26} strokeWidth={1.5} /></span>
              <span>
                <strong>{device.name} arızanız mı var?</strong>
                <small>Türkiye geneli servis ağımızla arıza kaydı oluşturun, sizi arayalım.</small>
              </span>
              <Icon name="arrow-right" size={20} />
            </a>
          )
        }

        <section aria-labelledby="more" class="more">
          <h2 id="more" class="more__t">Bunları da okuyun</h2>
          <ul>{more.map((m) => <li><a href={`/blog/${m.slug}`}><Icon name="arrow-right" size={15} /> {m.title}</a></li>)}</ul>
        </section>
      </div>
      <div class="ledger__rail"><RequestForm title="Arıza kaydı oluştur" presetDevice={post.device} /></div>
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 0.6rem;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--steel);
    font-size: var(--fs-sm);
    margin-bottom: 1.75rem;
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .post {
    font-size: var(--fs-md);
  }
  .post__h2 {
    font-size: var(--fs-lg);
    margin: 2rem 0 0.75rem;
  }
  .post__ul,
  .post__ol {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.15rem;
    padding-left: 1.35rem;
    color: var(--ink-2);
  }
  .post__ul {
    list-style: disc;
  }
  .post__ol {
    list-style: decimal;
  }
  .post__note {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    padding: 0.95rem 1.1rem;
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--r) var(--r) 0;
    background: var(--accent-tint);
    color: var(--accent-deep);
    font-size: var(--fs-sm);
  }
  .post__note svg {
    flex: none;
    margin-top: 2px;
  }
  .crossbox {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.25rem 0 0;
    padding: 1.25rem;
    border: 1.5px solid var(--brand);
    border-radius: var(--r-lg);
    background: var(--brand-tint);
    color: var(--ink);
  }
  .crossbox__ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 13px;
    background: #fff;
    color: var(--brand-deep);
  }
  .crossbox span {
    display: grid;
    gap: 0.1rem;
  }
  .crossbox small {
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .crossbox > svg {
    margin-left: auto;
    color: var(--brand-deep);
    flex: none;
  }
  .more {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .more__t {
    font-size: var(--fs-lg);
    margin-bottom: 0.75rem;
  }
  .more ul {
    display: grid;
    gap: 0.5rem;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--brand-deep);
  }
  .more svg {
    flex: none;
  }
</style>
